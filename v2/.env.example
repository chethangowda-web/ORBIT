# App
ENVIRONMENT=development
BACKEND_PORT=8002
FRONTEND_PORT=3001
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Database / cache
POSTGRES_USER=orbit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=orbit_v2
POSTGRES_PORT=5433
REDIS_PORT=6380
DATABASE_URL=postgresql+asyncpg://orbit:change-me@localhost:5433/orbit_v2
REDIS_URL=redis://localhost:6380/0

# Auth (generate with: python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/auth/callback

# LLM (leave keys empty to use the offline rule-based classifier)
GOOGLE_GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_MODEL=gemini/gemini-1.5-pro

# Google Chat
GOOGLE_CHAT_VERIFY_AUTH=true
GOOGLE_CHAT_AUDIENCE=
GOOGLE_CHAT_WEBHOOK_SECRET=
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json

# Observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Kolkata
