# ==============================================================================
# ORBIT: Multi-Agent AI Task Management System
# Environment Configuration Template
# ==============================================================================

# Application Settings
ENVIRONMENT=development
APP_NAME=ORBIT
DEBUG=true
PORT=8000
HOST=0.0.0.0
API_V1_PREFIX=/api
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://orbit:password@localhost:5432/orbit
POSTGRES_USER=orbit
POSTGRES_PASSWORD=password
POSTGRES_DB=orbit
POSTGRES_PORT=5432
DB_ECHO=false

# Redis Configuration (LangGraph checkpoints, cache, rate limits)
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
JWT_SECRET_KEY=change-this-in-production-super-secret-jwt-key-orbit-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers (LiteLLM unified interface)
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEFAULT_LLM_MODEL=gemini/gemini-1.5-pro
FAST_LLM_MODEL=gemini/gemini-1.5-flash
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# Google Chat Integration
GOOGLE_CHAT_WEBHOOK_SECRET=your_google_chat_webhook_secret_here
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json
GOOGLE_CHAT_SPACE_ID=spaces/sample-space-id

# Observability (LangSmith tracing - optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=orbit
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=5
