# ==============================================================================
# ORBIT: Multi-Agent AI Task Management System
# Environment configuration template.  cp .env.example .env  and edit.
# Never commit .env.  Leave optional secrets EMPTY rather than filling placeholders:
# a non-empty key makes ORBIT call that provider.
# ==============================================================================

# --- Application -------------------------------------------------------------
ENVIRONMENT=development            # development | production (production enforces the checks below)
APP_NAME=ORBIT
DEBUG=true
PORT=8001
HOST=0.0.0.0
API_V1_PREFIX=/api
LOG_LEVEL=INFO
# Browser origins allowed to call the API (JSON list). "*" is rejected in production.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Product timezone: defines "today" for due dates, digests and the scheduler.
APP_TIMEZONE=Asia/Kolkata

# Public self-registration is off by default. People join through Google sign-in,
# Google Chat, or an administrator.
ALLOW_REGISTRATION=false

# --- Database (PostgreSQL) ---------------------------------------------------
DATABASE_URL=postgresql+asyncpg://orbit:password@localhost:5432/orbit
POSTGRES_USER=orbit
POSTGRES_PASSWORD=password
POSTGRES_DB=orbit
POSTGRES_PORT=5432
DB_ECHO=false

# --- Redis (conversation checkpoints, scheduler job store/locks, rate limits) -
REDIS_URL=redis://localhost:6379/0

# --- Authentication ----------------------------------------------------------
# REQUIRED in production: at least 32 random characters, not shared with other systems.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Failed-login throttle per client IP + email.
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Google OAuth 2.0 sign-in (optional; the button reports "not configured" when empty)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# --- LLM (LiteLLM) -----------------------------------------------------------
# Leave both keys empty to use the deterministic offline intent classifier.
GOOGLE_GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_MODEL=gemini/gemini-1.5-pro
FAST_LLM_MODEL=gemini/gemini-1.5-flash
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# --- Google Chat -------------------------------------------------------------
# Production MUST set GOOGLE_CHAT_VERIFY_AUTH=true and GOOGLE_CHAT_AUDIENCE
# (your Cloud project number, or the HTTP endpoint URL, matching the app's
# "Authentication audience" setting). Without an audience, verification rejects everything.
GOOGLE_CHAT_VERIFY_AUTH=false
GOOGLE_CHAT_AUDIENCE=
# Optional shared secret. When set, every request must carry a valid X-Goog-Signature HMAC.
GOOGLE_CHAT_WEBHOOK_SECRET=
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CHAT_SPACE_ID=
# Raw Chat payloads contain PII; only enable while debugging.
LOG_WEBHOOK_PAYLOADS=false

# --- Observability (optional) ------------------------------------------------
# Prometheus scrape endpoint at /metrics: HTTP requests and latency, agent runs, tool
# calls, notification outcomes. Off by default; set a token to require
# 'Authorization: Bearer <token>' from the scraper.
METRICS_ENABLED=false
METRICS_TOKEN=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=orbit

# --- Scheduler ---------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_JOBSTORE=redis           # redis | memory

# --- Seed data (python -m db.seed) -------------------------------------------
# Development seeds demo users with the password "password123". Production refuses
# to seed unless SEED_PASSWORD (min 12 chars) is set.
SEED_PASSWORD=
SEED_ON_START=false                # docker compose: seed on container start

# --- Frontend (build time) ---------------------------------------------------
# URL the BROWSER uses to reach the API. Inlined into the bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:8001/api
